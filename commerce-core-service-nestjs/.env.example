# Core Service NestJS
PORT=8080
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=commerce
# Auto-create schema + seed admin user & sample data on boot
DB_SYNCHRONIZE=true
DB_SEED=true

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173
